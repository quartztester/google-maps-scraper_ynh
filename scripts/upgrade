#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# STOP SERVICES
#=================================================
ynh_script_progression "Stopping $app's services..."

ynh_systemctl --service="$app" --action="stop" --log_path="/var/log/$app/$app.log"

#=================================================
# UPDATE SOURCE FILES
#=================================================
ynh_script_progression "Updating source files..."

ynh_setup_source --dest_dir="$install_dir"

chmod 0755 "$install_dir/gmaps"
chown -R "$app:$app" "$install_dir"

#=================================================
# UPDATE PLAYWRIGHT BROWSERS
#=================================================
ynh_script_progression "Ensuring Playwright Chromium is up to date..."

mkdir -p "$browsers_dir"
chown "$app:$app" "$browsers_dir"

ynh_exec_as_app env PLAYWRIGHT_INSTALL_ONLY=1 \
	PLAYWRIGHT_BROWSERS_PATH="$browsers_dir" \
	"$install_dir/gmaps" \
	|| ynh_die "Failed to install Playwright Chromium"

#=================================================
# RECREATE CONFIGURATION
#=================================================
ynh_script_progression "Recreating systemd service..."

mkdir -p "/var/log/$app"
chown "$app:$app" "/var/log/$app"

ynh_config_add_systemd
yunohost service add "$app" --description="Google Maps Scraper web server" --log="/var/log/$app/$app.log"

ynh_script_progression "Recreating NGINX configuration..."

ynh_config_add_nginx

#=================================================
# START SERVICE
#=================================================
ynh_script_progression "Restarting $app's service..."

ynh_systemctl --service="$app" --action="start" --log_path="/var/log/$app/$app.log"

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Upgrade of $app completed"
